{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "api/analyze-artifacts.py", "use": "@vercel/python" },
    { "src": "api/contact.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/analyze-artifacts", "dest": "/api/analyze-artifacts.py" },
    { "src": "/api/contact", "dest": "/api/contact.js" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
